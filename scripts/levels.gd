## Stitches a level's chunks into HEIGHT rows of equal width.
static func build_map(index: int) -> Array:
	var lv: Dictionary = LIST[index]
	var rows := []
	for r in HEIGHT:
		rows.append("")
	for chunk in lv.chunks:
		var cw := 0
		for line in chunk:
			cw = maxi(cw, line.length())
		var pad: int = HEIGHT - chunk.size()
		for r in HEIGHT:
			var line: String
			if r < pad:
				line = lv.fill.repeat(cw)
			else:
				line = chunk[r - pad]
				if line.length() < cw:
					var filler := "#" if line.ends_with("#") else "."
					line += filler.repeat(cw - line.length())
			rows[r] += line
	return rows
