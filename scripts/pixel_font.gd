static var _tex: ImageTexture
static var _index := {}


static func _build() -> void:
	var keys := GLYPHS.keys()
	var img := Image.create(keys.size() * 5, 8, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for i in keys.size():
		var rows: PackedStringArray = GLYPHS[keys[i]].split("|")
		for y in rows.size():
			for x in rows[y].length():
				if rows[y][x] == "#":
					img.set_pixel(i * 5 + x, y, Color.WHITE)
		_index[keys[i]] = i
	_tex = ImageTexture.create_from_image(img)


## "@" draws a heart, "^" an up arrow, "`" a right arrow, "{" a left arrow.
static func draw(ci: CanvasItem, pos: Vector2, text: String, color := Color.WHITE, scale := 1, outline := Color(0, 0, 0, 0)) -> void:
	if _tex == null:
		_build()
	if outline.a > 0.0:
		for o in [Vector2(-1, 0), Vector2(1, 0), Vector2(0, -1), Vector2(0, 1), Vector2(1, 1)]:
			draw(ci, pos + o * scale, text, outline, scale)
	var x := pos.x
	var y := pos.y
	for ch in text:
		if ch == "\n":
			x = pos.x
			y += LINE * scale
			continue
		var idx: int = _index.get(ch, -1)
		if idx >= 0:
			ci.draw_texture_rect_region(_tex, Rect2(x, y, 5 * scale, 8 * scale), Rect2(idx * 5, 0, 5, 8), color)
		x += CW * scale


static func width(text: String, scale := 1) -> int:
	var best := 0
	for line in text.split("\n"):
		best = maxi(best, line.length())
	return maxi(0, best * CW - 1) * scale


static func draw_centered(ci: CanvasItem, center_x: float, y: float, text: String, color := Color.WHITE, scale := 1, outline := Color(0, 0, 0, 0)) -> void:
	for line in text.split("\n"):
		draw(ci, Vector2(roundf(center_x - width(line, scale) / 2.0), y), line, color, scale, outline)
		y += LINE * scale


## Greedy word wrap to max_chars per line; keeps explicit newlines.
static func wrap(text: String, max_chars: int, indent := "") -> String:
	var out := []
	for para in text.split("\n"):
		var line := ""
		for word in para.split(" "):
			if line == "":
				line = word
			elif line.length() + 1 + word.length() <= max_chars:
				line += " " + word
			else:
				out.append(line)
				line = indent + word
		out.append(line)
	return "\n".join(out)
